{
	"format_version": "1.21.110",
	"minecraft:block": {
		"description": {
			"states": {
				"cb2:summon": [
					0,
					1,
					2
				]
			},
			"identifier": "cb2:fragment_frame"
		},
		"permutations": [
			{
				"condition": "!query.block_state('cb2:summon')",
				"components": {
					"minecraft:geometry": {
						"identifier": "minecraft:geometry.full_block"
					},
					"minecraft:material_instances": {
						"*": {
							"face_dimming": false,
							"ambient_occlusion": true,
							"render_method": "blend",
							"texture": "cb2_fragment_frame_off"
						}
					}
				}
			},
			{
				"condition": "query.block_state('cb2:summon') >= 1",
				"components": {
					"minecraft:geometry": "minecraft:geometry.full_block",
					"minecraft:material_instances": {
						"*": {
							"face_dimming": false,
							"ambient_occlusion": true,
							"render_method": "blend",
							"texture": "cb2_fragment_frame_on"
						}
					}
				}
			},
			{
				"condition": "query.block_state('cb2:summon') == 1",
				"components": {
					"minecraft:tick": {
						"interval_range": [
							10,
							30
						]
					},
					"cb2:fragmentframe": {}
				}
			},
			{
				"condition": "query.block_state('cb2:summon') == 2",
				"components": {
					"tag:cb2:orbshard": {},
					"tag:minecraft:is_pickaxe_item_destructible": {},
					"minecraft:destructible_by_mining": {
						"seconds_to_destroy": 12
					},
					"minecraft:tick": {
						"interval_range": [
							60,
							240
						]
					},
					"minecraft:light_emission": 8,
					"cb2:barrierframe": {},
					"cb2:fragmentframe": {}
				}
			}
		],
		"components": {
			"minecraft:loot": "loot_tables/empty.json",
			"fristia:onInteract": {
				"runCommand": {
					"run": [
						"execute if block ~~~ cb2:fragment_frame [\"cb2:summon\"=1] run fristia:break",
						"execute if entity @s[hasItem={item=cb2:crystal_heart_shard,quantity=0,location=slot.weapon.mainhand}] run fristia:break",
						"clear @s cb2:crystal_heart_shard 0 1",
						"playsound block.end_portal_frame.fill @a ~~~ 1 1.2",
						"particle cb2:crystal_particle_pop ~~~",
						"setblock ~~~ cb2:fragment_frame [\"cb2:summon\"=1]"
					]
				}
			},
			"minecraft:destructible_by_explosion": false,
			"minecraft:destructible_by_mining": {
				"seconds_to_destroy": 999999999999
			},
			"minecraft:geometry": "minecraft:geometry.cross",
			"minecraft:material_instances": {
				"*": {
					"face_dimming": false,
					"ambient_occlusion": true,
					"render_method": "blend",
					"texture": "cb2_boss_frame"
				}
			}
		}
	}
}