{
	"format_version": "1.8.0",
	"minecraft:spawn_rules": {
		"description": {
			"identifier": "cb2:crystal_guard_spawn",
			"population_control": "monster"
		},
		"conditions": [
			{
				"minecraft:spawns_on_surface": {},
				"minecraft:brightness_filter": {
					"min": 0,
					"max": 15,
					"adjust_for_weather": true
				},
				"minecraft:difficulty_filter": {
					"min": "easy",
					"max": "hard"
				},
				"minecraft:weight": {
					"default": 100
				},
				"minecraft:herd": {
					"min_size": 1,
					"max_size": 1
				},
				"minecraft:biome_filter": [
					{
						"all_of": [
							{
								"any_of": [
									{
										"test": "has_biome_tag",
										"operator": "==",
										"value": "crystal"
									}
								]
							},
							{
								"test": "has_biome_tag",
								"operator": "!=",
								"value": "cluster"
							}
						]
					}
				]
			}
		]
	}
}