{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.crystal_spawner_entity": {
			"states": {
				"default": {
					"animations": [
						"idle"
					],
					"transitions": [
						{
							"active": "query.is_casting"
						}
					]
				},
				"active": {
					"animations": [
						"spawn"
					],
