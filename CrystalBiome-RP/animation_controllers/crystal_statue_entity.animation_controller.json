{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.crystal_statue_entity_holditem": {
			"states": {
				"default": {
					"animations": [
						"none"
					],
					"transitions": [
						{
							"active": "query.is_item_equipped('slot.weapon.mainhand')&&!query.is_item_name_any('slot.weapon.mainhand',0,'cb2:crysteel_axe')"
						}
					],
					"blend_transition": 0.2
				},
				"active": {
					"animations": [
						"itemhold"
					],
					"transitions": [
						{
							"default": "!query.is_item_equipped('slot.weapon.mainhand')"
						}
					],
					"blend_transition": 0.2
				}
			}
		}
	}
}