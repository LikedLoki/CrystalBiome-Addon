{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.moving": {
			"initial_state": "idle",
			"states": {
				"idle": {
					"animations": [
						"idle"
					],
					"transitions": [
						{
							"walking": "q.modified_move_speed>0.05"
						}
					],
					"blend_transition": 0.2
				},
				"walking": {
					"animations": [
						"move"
					],
					"transitions": [
						{
							"idle": "q.modified_move_speed<0.05"
						}
					],
					"blend_transition": 0.2
				}
			}
		}
	}
}