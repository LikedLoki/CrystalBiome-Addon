{
  "namespace": "server_form",
  "long_form": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [
            "100% - 15px",
            10
          ],
          "$title_max_size": [
            "100% - 15px",
            10
          ],
          "size": [
            225,
            200
          ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.long_form_panel",
          "layer": 2,
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text - 'cb2:enc_table') = #title_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "custom_group": {
          "type": "panel",
          "size": [
            "100%",
            "100%"
          ],
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'cb2:enc_table') = #title_text))",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "limited_bg": {
                "type": "image",
                "texture": "textures/ui/white",
                "color": [
                  0,
                  0,
                  0
                ],
                "alpha": 0.4,
                "size": [
                  "100% + 2000px",
                  "100% + 2000px"
                ],
                "layer": 1,
                "anchor_from": "center",
                "anchor_to": "center"
              }
            },
            {
              "723lv7namespace@723lv7namespace.723lv7namespace": {
                "layer": 2,
                "bindings": [
                  {
                    "binding_name": "#title_text"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "( not ((#title_text - 'cb2:enc_table') = #title_text))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}